<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIS_Practica_One_Model\Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="BrandForm.cs">
      <CustomToolNamespace>Winforms</CustomToolNamespace>
    </Compile>
    <Compile Update="MainForm.cs">
      <CustomToolNamespace>WinForms</CustomToolNamespace>
    </Compile>
  </ItemGroup>

</Project>